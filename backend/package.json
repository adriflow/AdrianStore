{
  "name": "adrianstore-backend",
  "version": "0.1.0",
  "description": "Backend de AdrianStore con NestJS y PostgreSQL",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "cross-env NODE_ENV=test JWT_SECRET=test-secret-key THROTTLE_LIMIT=100000 THROTTLE_TTL=1 LOGIN_THROTTLE_LIMIT=100000 LOGIN_THROTTLE_TTL=1 jest --runInBand",
    "seed": "ts-node src/seeder.ts",
    "clean": "ts-node src/clean-db.ts",
    "setup:admin": "ts-node src/setup-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@nestjs/common": "^10.2.0",
    "@nestjs/core": "^10.2.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.2.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^5.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sql.js": "^1.14.1",
    "swagger-ui-express": "^4.6.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@jest/types": "^29.6.3",
    "@nestjs/cli": "^10.2.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.5",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.11.0",
    "@types/supertest": "^2.0.12",
    "cross-env": "^7.0.3",
    "jest": "^29.6.2",
    "pg-mem": "^2.1.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
