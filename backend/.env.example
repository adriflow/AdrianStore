# Puerto del backend
PORT=3000

# Modo producción: NODE_ENV=production (activa CSP estricto, cookies secure y oculta Swagger)
NODE_ENV=development

# Secreto JWT (obligatorio). Genera uno fuerte con: openssl rand -hex 48
JWT_SECRET=

# PostgreSQL
# Opción A: cadena de conexión única (Neon, Supabase, Render, Railway...). Si se define, tiene prioridad.
DATABASE_URL=
# DB_SSL=true fuerza TLS; por defecto se activa solo si hay DATABASE_URL. Ponlo en false para Postgres local sin TLS.
DB_SSL=

# Opción B: variables sueltas (Postgres local o self-hosted)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=adrianstore

# URLs públicas (en producción apuntan a tu dominio, p. ej. https://adrianstore.ladetec.com)
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# Credenciales del administrador (se aplican con: npm run setup:admin)
ADMIN_USERNAME=adrian0502
ADMIN_PASSWORD=

# Límites de peticiones (anti abuso)
THROTTLE_LIMIT=20
THROTTLE_TTL=60000
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL=60000

# Cloudflare R2 (storage de imágenes). Si se dejan vacías, las imágenes se guardan en
# disco local (backend/uploads/) — válido para dev, NO recomendado en producción/PaaS
# con filesystem efímero (Render, Fly, Railway...).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública del bucket: dominio custom (wrangler r2 bucket domain add) o el pub-*.r2.dev
# que da el dashboard al activar "Public Development URL". Sin barra final.
R2_PUBLIC_URL=
