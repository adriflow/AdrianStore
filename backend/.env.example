# Puerto del backend
PORT=3000

# Modo producción: NODE_ENV=production (activa CSP estricto, cookies secure y oculta Swagger)
NODE_ENV=development

# Secreto JWT (obligatorio). Genera uno fuerte con: openssl rand -hex 48
JWT_SECRET=

# PostgreSQL
# Opción A: cadena de conexión única. Con Supabase, usa la conexión directa (proyecto
# corre como servicio persistente, no serverless): postgres://postgres:[PASSWORD]@db.[project_ref].supabase.co:5432/postgres
# Si tu red no soporta IPv6, usa el pooler en modo sesión (puerto 5432, no 6543 —
# el modo transacción del pooler no es para conexiones persistentes tipo Pool):
# postgres://postgres.[project_ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=
# DB_SSL=true fuerza TLS; por defecto se activa solo si hay DATABASE_URL (Supabase lo requiere siempre).
DB_SSL=

# Opción B: variables sueltas (Postgres local o self-hosted)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=adrianstore

# URLs públicas (en producción apuntan a tu dominio, p. ej. https://adrianstore.ladetec.com)
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# Credenciales del administrador (se aplican con: npm run setup:admin)
ADMIN_USERNAME=adrian0502
ADMIN_PASSWORD=

# Límites de peticiones (anti abuso)
THROTTLE_LIMIT=20
THROTTLE_TTL=60000
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL=60000

# Supabase Storage (API S3-compatible, storage de imágenes). Si se dejan vacías, las
# imágenes se guardan en disco local (backend/uploads/) — válido para dev, NO recomendado
# en producción/PaaS con filesystem efímero (Render, Fly, Railway...).
# Bucket debe ser público (Storage > Buckets > New bucket > Public).
SUPABASE_PROJECT_REF=
# Región mostrada en Storage > Settings > S3 Connection (p. ej. us-east-1), no el region
# de la instancia Postgres.
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=
# Access keys de Storage > Settings > S3 Connection > New access key (no son las API keys
# normales del proyecto).
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
