{
  "name": "adrianstore",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:backend": "pnpm --filter adrianstore-backend start:dev",
    "dev:frontend": "pnpm --filter adrianstore-frontend start",
