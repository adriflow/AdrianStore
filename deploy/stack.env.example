# Variables para deploy/docker-stack.yml. Copiar a deploy/stack.env (gitignored) y
# completar, luego: export $(grep -v '^#' deploy/stack.env | xargs)

BACKEND_IMAGE=ghcr.io/adriflow/adrianstore-backend
BACKEND_TAG=latest

# Dominio del backend. NO puede ser el mismo hostname que Cloudflare Pages (el DNS
# de un hostname solo puede apuntar a un destino) — usa un subdominio para la API.
BACKEND_DOMAIN=api.adrianstore.ladetec.com
BACKEND_URL=https://api.adrianstore.ladetec.com
# Dominio real donde vive el frontend en Cloudflare Pages (para CORS).
FRONTEND_URL=https://adrianstore.ladetec.com

# Postgres en Supabase (proyecto Database > Connect). Conexión directa recomendada
# para este backend persistente (pg.Pool), puerto 5432:
DATABASE_URL=postgres://postgres:password@db.PROJECT_REF.supabase.co:5432/postgres
DB_SSL=true

JWT_SECRET=
ADMIN_USERNAME=adrian0502
ADMIN_PASSWORD=

THROTTLE_LIMIT=20
THROTTLE_TTL=60000
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL=60000

# Supabase Storage (Storage > Settings > S3 Connection). Bucket debe ser público.
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
